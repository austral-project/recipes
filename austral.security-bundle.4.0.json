{
    "manifests": {
        "austral/security-bundle": {
            "manifest": {
                "bundles": {
                    "Austral\\SecurityBundle\\AustralSecurityBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "src/": "%SRC_DIR%/"
                },
                "post-install-output": [
                    "  * Use the Austral users in the firewall of <comment>config/packages/security.yaml</>:",
                    "",
                    "    <fg=green>firewalls:",
                    "        main:",
                    "            provider:       austral_security_user",
                    "            user_checker:   austral.security.user_checker</>",
                    "",
                    "  * Create the tables:",
                    "    1. <comment>php bin/console doctrine:migrations:diff</>",
                    "    2. <comment>php bin/console doctrine:migrations:migrate</>",
                    "",
                    "  * Create a root user:",
                    "    <comment>php bin/console austral:security:user --email=you@example.com --root --create</>",
                    "",
                    "  * Read the documentation at <comment>https://github.com/austral-project/security-bundle</>"
                ]
            },
            "files": {
                "config/packages/austral_security.yaml": {
                    "contents": [
                        "austral_security:",
                        "    # Classes of the application (src/Entity/Austral/SecurityBundle): these are the defaults",
                        "    # entities:",
                        "    #     user:   App\\Entity\\Austral\\SecurityBundle\\User",
                        "    #     role:   App\\Entity\\Austral\\SecurityBundle\\Role",
                        "    #     group:  App\\Entity\\Austral\\SecurityBundle\\Group",
                        "",
                        "    password_reset:",
                        "        lifetime:           3600    # seconds a reset link is valid (60 minimum)",
                        "        request_interval:   60      # seconds before a new link can be requested for the same user",
                        "",
                        "    # Firewall of config/packages/security.yaml with \"login_link\"; no login link when not set",
                        "    # login_link:",
                        "    #     firewall: main",
                        "",
                        "# Merged with config/packages/security.yaml. The firewall stays in security.yaml: Symfony accepts",
                        "# the firewalls in one file only. Use there the provider \"austral_security_user\" and the user checker",
                        "# \"austral.security.user_checker\".",
                        "security:",
                        "    role_hierarchy:",
                        "        ROLE_ROOT:  [ ROLE_ADMIN_ACCESS, ROLE_USER_ACCESS ]",
                        "",
                        "    password_hashers:",
                        "        App\\Entity\\Austral\\SecurityBundle\\User: 'auto'",
                        "",
                        "    providers:",
                        "        austral_security_user:",
                        "            id: austral.security.user_provider",
                        ""
                    ],
                    "executable": false
                },

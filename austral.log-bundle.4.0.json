{
    "manifests": {
        "austral/log-bundle": {
            "manifest": {
                "bundles": {
                    "Austral\\LogBundle\\AustralLogBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "src/": "%SRC_DIR%/"
                },
                "post-install-output": [
                    "  * Create the tables of the errors:",
                    "    1. <comment>php bin/console doctrine:migrations:diff</>",
                    "    2. <comment>php bin/console doctrine:migrations:migrate</>",
                    "",
                    "  * The errors are recorded from now on (Monolog level \"error\" or higher):",
                    "    nothing to add to <comment>config/packages/monolog.yaml</>.",
                    "",
                    "  * Read the documentation at <comment>https://github.com/austral-project/log-bundle</>"
                ]
            },
            "files": {
                "config/packages/austral_log.yaml": {
                    "contents": [
                        "austral_log:",
                        "    # The errors of the site (Monolog level \"error\" or higher, every channel) are recorded in the database.",
                        "    enabled:    true",
                        "    # Lowest level recorded: error, critical, alert or emergency",
                        "    level:      error",
                        "",
                        "    # The HTTP errors of the visitors (4xx) are not recorded, except these codes; the 5xx are always recorded",
                        "    # capture_client_errors: [ 404, 403 ]",
                        "",
                        "    # Doctrine connection of the tables; the errors are written by a second connection, out of the transactions",
                        "    # connection: default",
                        "",
                        "    # Occurrences kept by error, the last ones",
                        "    occurrences_limit: 50",
                        "",
                        "    # Classes of the application (src/Entity/Austral/LogBundle): these are the defaults",
                        "    # entities:",
                        "    #     error:      App\\Entity\\Austral\\LogBundle\\ErrorLog",
                        "    #     occurrence: App\\Entity\\Austral\\LogBundle\\ErrorOccurrence",
                        "",
                        "when@test:",
                        "    austral_log:",
                        "        enabled: false",
                        ""
                    ],
                    "executable": false
                },
                "src/Entity/Austral/LogBundle/ErrorLog.php": {
                    "contents": [
                        "<?php",
                        "/*",
                        " * This file is autogenerate and part of the Austral Log package.",
                        " *",
                        " * (c) Austral <support@austral.dev>",
                        " *",
                        " * For the full copyright and license information, please view the LICENSE",
                        " * file that was distributed with this source code.",
                        " */",
                        "",
                        "namespace App\\Entity\\Austral\\LogBundle;",
                        "",
                        "use Austral\\LogBundle\\Entity\\ErrorLog as BaseErrorLog;",
                        "",
                        "use Doctrine\\ORM\\Mapping as ORM;",
                        "",
                        "/**",
                        " * Austral Error Log Entity.",
                        " *",
                        " * @author Matthieu Beurel <matthieu@austral.dev>",
                        " */",
                        "#[ORM\\Table(name: \"austral_log_error\")]",
                        "#[ORM\\Index(name: \"austral_log_error_status\", columns: [\"status\"])]",
                        "#[ORM\\Index(name: \"austral_log_error_last_seen\", columns: [\"last_seen\"])]",
                        "#[ORM\\Entity(repositoryClass: \\Austral\\LogBundle\\Repository\\ErrorLogRepository::class)]",
                        "class ErrorLog extends BaseErrorLog",
                        "{",
                        "}",
                        ""
                    ],
                    "executable": false
                },
                "src/Entity/Austral/LogBundle/ErrorOccurrence.php": {
                    "contents": [
                        "<?php",
                        "/*",
                        " * This file is autogenerate and part of the Austral Log package.",
                        " *",
                        " * (c) Austral <support@austral.dev>",
                        " *",
                        " * For the full copyright and license information, please view the LICENSE",
                        " * file that was distributed with this source code.",
                        " */",
                        "",
                        "namespace App\\Entity\\Austral\\LogBundle;",
                        "",
                        "use Austral\\LogBundle\\Entity\\ErrorOccurrence as BaseErrorOccurrence;",
                        "",
                        "use Doctrine\\ORM\\Mapping as ORM;",
                        "",
                        "/**",
                        " * Austral Error Occurrence Entity.",
                        " *",
                        " * @author Matthieu Beurel <matthieu@austral.dev>",
                        " */",
                        "#[ORM\\Table(name: \"austral_log_error_occurrence\")]",
                        "#[ORM\\Entity(repositoryClass: \\Austral\\LogBundle\\Repository\\ErrorOccurrenceRepository::class)]",
                        "class ErrorOccurrence extends BaseErrorOccurrence",
                        "{",
                        "}",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "f5de571488db57f613d404fad9d3fc35730903df"
        }
    }
}

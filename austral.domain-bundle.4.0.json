{
    "manifests": {
        "austral/domain-bundle": {
            "manifest": {
                "bundles": {
                    "Austral\\DomainBundle\\AustralDomainBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "src/": "%SRC_DIR%/"
                },
                "post-install-output": [
                    "  * Create the table of the domains (<comment>austral_http_domain</>, the table of the 3.1 is kept as it is):",
                    "    1. <comment>php bin/console doctrine:migrations:diff</>",
                    "    2. <comment>php bin/console doctrine:migrations:migrate</>",
                    "",
                    "  * Add the domains of the site in the admin (<comment>/austral-admin/domain</>, with admin-bundle).",
                    "    Without domain, the host of the request is the master domain.",
                    "",
                    "  * Attach the existing entities filtered by domain to the master domain:",
                    "    <comment>php bin/console austral:domain:migrate</>",
                    "",
                    "  * Read the documentation at <comment>https://github.com/austral-project/domain-bundle</>"
                ]
            },
            "files": {
                "config/packages/austral_domain.yaml": {
                    "contents": [
                        "austral_domain:",
                        "    # Keeps the enabled domains in the Doctrine result cache of cache-bundle (also needs austral_cache.enabled)",
                        "    cache: true",
                        "",
                        "# The entity of the application is src/Entity/Austral/DomainBundle/Domain.php (the default). Another class:",
                        "# parameters:",
                        "#     austral.entity.domain.class: App\\Entity\\Domain",
                        ""
                    ],
                    "executable": false
                },
                "src/Entity/Austral/DomainBundle/Domain.php": {
                    "contents": [
